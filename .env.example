# Neon Database
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
NEON_BRANCH="production"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL="https://your-auth-endpoint.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-auth-endpoint.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="your-32-character-cookie-secret"

# App URLs
NEXT_PUBLIC_APP_DOMAIN="candid.avikmukherjee.com"
NEXT_PUBLIC_APP_URL="https://candid.avikmukherjee.com"
